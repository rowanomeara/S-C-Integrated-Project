<mujoco model="41014_integrated_project_arena">
  <compiler angle="radian" meshdir="../models/turtlebot3/assets/"/>
<!-- Include the sensor-equipped TurtleBot3 Burger -->
  <include file="../models/turtlebot3/turtlebot3_burger.xml"/>

  <statistic center="0 0 0.5" extent="4.0"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.3 0.3 0.3" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="135" elevation="-30"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0.05 0.05 0.1" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.25 0.3 0.35" rgb2="0.2 0.25 0.3"
             markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="10 10" reflectance="0.1"/>

    <!-- ArUco Marker Texture & Material for Docking Wall -->
    <texture name="aruco_tex" type="2d" file="../textures/aruco_marker_0.png"/>
    <material name="aruco_mat" texture="aruco_tex" specular="0" reflectance="0"/>

    <!-- Workcell materials -->
    <material name="table_wood" rgba="0.55 0.38 0.25 1"/>
    <material name="safety_yellow" rgba="0.95 0.8 0.1 1"/>
    <material name="dock_metal" rgba="0.2 0.25 0.3 1"/>
    <material name="wall_mat" rgba="0.85 0.85 0.85 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 3.0" dir="0 0 -1" directional="true"/>

    <!-- Floor (5m x 5m effective arena) -->
    <geom name="floor" size="3.0 3.0 0.05" type="plane" material="groundplane"/>

    <!-- Perimeter Boundary Walls -->
    <geom name="wall_north" type="box" size="2.6 0.05 0.25" pos="0 2.6 0.25" material="wall_mat"/>
    <geom name="wall_south" type="box" size="2.6 0.05 0.25" pos="0 -2.6 0.25" material="wall_mat"/>
    <geom name="wall_east"  type="box" size="0.05 2.6 0.25" pos="2.6 0 0.25" material="wall_mat"/>
    <geom name="wall_west"  type="box" size="0.05 2.6 0.25" pos="-2.6 0 0.25" material="wall_mat"/>

    <!-- ================= OBSTACLES (FROM INDUSTRIAL ROBOTICS SCENE) ================= -->
    <!-- Central Workcell Table (Table 2.1m x 1.4m x 0.6m at x=0.5, y=0.5) -->
    <geom name="workcell_table" type="box" size="1.05 0.7 0.3" pos="0.5 0.5 0.3" material="table_wood"/>

    <!-- Industrial Safety Barriers (1.5m x 0.2m x 1.0m) -->
    <geom name="barrier1" type="box" size="0.75 0.1 0.5" pos="0.3 1.8 0.5" material="safety_yellow"/>
    <geom name="barrier2" type="box" size="0.75 0.1 0.5" pos="1.7 1.4 0.5" euler="0 0 -0.785" material="safety_yellow"/>
    <geom name="barrier3" type="box" size="0.75 0.1 0.5" pos="-1.2 1.7 0.5" euler="0 0 0.44" material="safety_yellow"/>

    <!-- Additional obstacle cylinder creating a tight turn -->
    <geom name="pillar_obstacle" type="cylinder" size="0.18 0.5" pos="-0.5 0.6 0.5" rgba="0.7 0.3 0.3 1"/>

    <!-- ================= CHARGING STATION & ARUCO DOCK ================= -->
    <!-- Docking bay backplate at (x = -1.2, y = 0.1) -->
    <body name="charging_dock" pos="-1.2 0.1 0">
      <!-- Back support wall -->
      <geom name="dock_back" type="box" size="0.04 0.22 0.18" pos="0 0 0.18" material="dock_metal"/>
      <!-- Guide bumper rails -->
      <geom name="guide_left"  type="box" size="0.15 0.02 0.04" pos="0.12  0.18 0.04" euler="0 0 0.2"  material="safety_yellow"/>
      <geom name="guide_right" type="box" size="0.15 0.02 0.04" pos="0.12 -0.18 0.04" euler="0 0 -0.2" material="safety_yellow"/>
      <!-- ArUco Marker Target Plate (facing approach along +X) -->
      <geom name="aruco_plate" type="box" size="0.002 0.08 0.08" pos="0.042 0 0.12" material="aruco_mat"/>
    </body>
  </worldbody>

  <!-- Default Start Pose: x=-1.7, y=0.5, z=0.033, heading=-90 deg (matching assignment_1.py) -->
  <keyframe>
    <key name="start_pose" qpos="-1.7 0.5 0.033 0.7071 0 0 -0.7071 0 0"/>
  </keyframe>
</mujoco>
