<mujoco model="arena">
  <compiler angle="radian" meshdir="../models/turtlebot3/assets/"/>
  <include file="../models/turtlebot3/turtlebot3_burger.xml"/>

  <asset>
    <texture name="aruco" type="2d" file="../textures/aruco_marker_0.png"/>
    <material name="aruco_mat" texture="aruco"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.9 0.9 0.9 1"/>

    <!-- Walls -->
    <geom name="wall_n" type="box" size="1.85 0.05 0.25" pos="0 1.8 0.25" rgba="0.8 0.8 0.8 1"/>
    <geom name="wall_s" type="box" size="1.85 0.05 0.25" pos="0 -1.8 0.25" rgba="0.8 0.8 0.8 1"/>
    <geom name="wall_e" type="box" size="0.05 1.85 0.25" pos="1.8 0 0.25" rgba="0.8 0.8 0.8 1"/>
    <geom name="wall_w" type="box" size="0.05 1.85 0.25" pos="-1.8 0 0.25" rgba="0.8 0.8 0.8 1"/>

    <!-- Obstacles -->
    <geom name="box_center" type="box" size="0.15 0.28 0.2" pos="-0.2 0.0 0.2" rgba="0.9 0.45 0.1 1"/>
    <geom name="cyl_obs1" type="cylinder" size="0.16 0.2" pos="0.45 0.65 0.2" rgba="0.1 0.5 0.9 1"/>
    <geom name="cyl_obs2" type="cylinder" size="0.16 0.2" pos="0.45 -0.65 0.2" rgba="0.1 0.5 0.9 1"/>

    <!-- Charging Dock + ArUco Marker -->
    <geom name="dock" type="box" size="0.05 0.2 0.15" pos="-1.75 0 0.15" rgba="0.25 0.25 0.25 1"/>
    <geom name="marker" type="box" size="0.001 0.08 0.08" pos="-1.69 0 0.15" material="aruco_mat"/>
  </worldbody>

  <keyframe>
    <!-- Default spawn -->
    <key name="start_pose" qpos="1.1 0.0 0.033 0 0 0 1 0 0"/>
  </keyframe>
</mujoco>